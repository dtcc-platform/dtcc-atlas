{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/main.ts",
    "src/vite-env.d.ts",
    "src/lib/**/*.ts",
    "src/**/*.svelte"
  ],
  "exclude": [
    "src/api",
    "src/forms",
    "src/services",
    "src/map",
    "src/storage",
    "src/bookmarks",
    "src/types",
    "src/state",
    "src/ui",
    "src/main.old.ts"
  ]
}
